APP_NAME=OfficePro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=officepro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" delivers notifications immediately. Use "database" and run
# `php artisan queue:work` in production to process them in the background.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Password-reset and notification e-mails. "log" writes them to
# storage/logs/laravel.log; configure SMTP for real delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@officepro.test"
MAIL_FROM_NAME="${APP_NAME}"

# Used only by `php artisan db:seed --class=ProductionSeeder`
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
